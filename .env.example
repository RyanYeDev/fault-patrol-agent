# Fault Patrol Agent 环境变量配置模版
# 使用方式：复制本文件为 .env 并填入真实凭据（.env 已被 .gitignore 忽略，不会提交至开源仓库）

# -------------------------------------------------------------
# 大模型与向量模型凭证（支持任意 OpenAI 兼容接口）
# -------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-llm-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key

# -------------------------------------------------------------
# 基础设施连接凭证（Docker 默认密码）
# -------------------------------------------------------------
MYSQL_USERNAME=root
MYSQL_PASSWORD=12345678
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=postgres

# -------------------------------------------------------------
# 平台接口鉴权密钥（为空则本地默认不鉴权）
# -------------------------------------------------------------
INSPECT_API_KEY=
ADMIN_API_KEY=
WEBHOOK_SECRET=
